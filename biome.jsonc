{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "extends": ["./conventions/biome.base.json"],
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "linter": {
    "rules": {
      "correctness": {
        // wish we could use this but it doesn't work with tsconfig path aliases
        "noUndeclaredDependencies": "off"
      },
      "suspicious": {
        "noUnknownAtRules": "off"
      }
    }
  },
  "files": {
    "includes": [
      "**",
      "!!**/coverage",
      "!!**/dist",
      "!**/node_modules",
      "!**/playwright/results",
      "!**/studio", // The Sanity Studio is its own package with its own eslint/prettier setup.
      "!!**/soundcloudWidget.js"
    ]
  }
}
