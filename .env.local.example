# Copy this file to .env.local and fill in the values.
# Find these at https://sanity.io/manage -> your project -> API

# Required: your Sanity project ID (e.g. vl7cr5b0)
SANITY_PROJECT_ID=

# Required: dataset name (e.g. production)
SANITY_DATASET=

# Optional: only needed to query draft/unpublished content
SANITY_TOKEN=
